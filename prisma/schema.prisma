generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}
enum DietType {
  cutting
  bulking
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())

  habits       Habit[]
  diets        Diet[]
  dietProgress DietProgress[]
  waterProgress  WaterProgress[]
  status       statusPhysical[]  // histórico de status físicos
}

model Habit {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  time        String?

  frequency   String     // 'daily' | 'weekly' | 'custom'
  createdAt   DateTime   @default(now())

  userId      String     @db.ObjectId
  user        User       @relation(fields: [userId], references: [id])

  logs        HabitLog[]
}

model HabitLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  dayKey    String   // "2025-09-09"
  status    Boolean  @default(true)

  habitId   String   @db.ObjectId
  habit     Habit    @relation(fields: [habitId], references: [id])

  @@unique([habitId, dayKey])
}

model Diet {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  type         DietType?
  description  String?
  period       String     // Ex: "Café da manhã", "Almoço", "Jantar"
  datekey      String
  meta         Float?
  atingiumeta  Boolean    @default(false)
  createdAt    DateTime   @default(now())

  userId       String     @db.ObjectId
  user         User       @relation(fields: [userId], references: [id])

  foods        Food[]
}

model Food {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  description String
  grams       Float
  calories    Float
  protein     Float @default(0)
  carbs       Float @default(0)
  originalCalories Float?   
  originalProtein  Float?   
  originalCarbs    Float?   
  originalGrams    Float?
  
  dietId      String   @db.ObjectId
  diet        Diet     @relation(fields: [dietId], references: [id])
}

model statusPhysical {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  weight         Float
  height         Float
  age            Int
  genere         String
  datekey        String?
  imc            Float
  tmb            Float
  goalcalories   Float?
  metawater      Float?       
  createdAt      DateTime? @default(now())

  userId         String   @db.ObjectId
  user           User     @relation(fields: [userId], references: [id])
}
model WaterProgress {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  date      DateTime 
  water     Float
  goal      Float
  achieved  Boolean
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date], name: "userId_dates")
}

model DietProgress {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  date      DateTime 
  calories  Float
  goal      Float
  achieved  Boolean
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date], name: "userId_date")
}
